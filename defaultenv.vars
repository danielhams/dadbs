##############################
##  WARNING WARNING WARNING ##
##                          ##
##  Do not directly edit    ##
##  this file - that will   ##
##  change packages hashes  ##
##  and you'll need to      ##
##  rebuild everything.     ##
##                          ##
##  Add add a new file      ##
##  'overrideenv.vars'      ##
##  and put your changes    ##
##  there.                  ##
##                          ##
##############################
# General

# irix
EDITOR=emacs
LC_ALL=C

# Don't put the install directory into the PATH yet.
#PATH=/usr/dadbs/current/bin:/usr/dadbsbootstrap/bin:/usr/gnutc295stage3/bin:/usr/gnutc/bin:/usr/sbin:/sbin:/usr/bsd:/usr/bin:/usr/bin/X11
#LD_LIBRARY_PATH=/usr/dadbs/current/lib:/usr/dadbsbootstrap/lin:/usr/gnutc295stage3/lib:/usr/gnutc/lib:/usr/lib:/lib

PATH=/usr/gnutc295stage3/bin:/usr/gnutc/bin:/usr/sbin:/sbin:/usr/bsd:/usr/bin:/usr/bin/X11
LD_LIBRARY_PATH=/usr/gnutc295stage3/lib:/usr/gnutc/lib:/usr/lib:/lib

SED=/usr/gnutc/bin/sed
PERL=/usr/dadbsbootstrap/bin/perl

# These have to be full, explicit paths
#SHELL=/usr/gnutc/bin/bash-3
#CONFIG_SHELL=/usr/gnutc/bin/bash-3
SHELL=/usr/gnutc/bin/mksh
CONFIG_SHELL=/usr/gnutc/bin/mksh

DIDBS_JOBS=1

DIDBS_GCC_CC=gcc
DIDBS_CC=gcc
DIDBS_GCC_CXX=g++
DIDBS_CXX=g++
DIDBS_GCC_OPT_SWITCH=-Os
DIDBS_ARCH_CFLAGS=-Os
DIDBS_ARCH_LDFLAGS=
