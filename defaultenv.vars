##############################
##  WARNING WARNING WARNING ##
##                          ##
##  Do not directly edit    ##
##  this file - that will   ##
##  change packages hashes  ##
##  and you'll need to      ##
##  rebuild everything.     ##
##                          ##
##  Add add a new file      ##
##  'overrideenv.vars'      ##
##  and put your changes    ##
##  there.                  ##
##                          ##
##############################
# General

LC_ALL=C

# Where to pull previous code from (for the stage1 builds)
DADBS_BOOT_ROOT=/usr/dadbs/current
# The "INSTALL_ROOT" comes from the bootstrap.conf file that
# bootstrap.pl find - it will be set and mirrors the above naming like this:
#######################################
# EXAMPLE ONLY - DO NOT UNCOMMENT!    #
# DADBS_INSTALL_ROOT=/usr/dadbs/0.1.1 #
#######################################

# Don't put either the install directory or the bootstrap root into the PATH
# This will be handled by bootstrap.pl itself.
PATH=/usr/sbin:/sbin:/usr/bsd:/usr/bin:/usr/bin/X11
LD_LIBRARY_PATH=/usr/lib:/lib:/usr/lib/X11

# Special "SHELL" vars that can be used to refer to the "BOOT" shells
# (during stage1)
# Will create env vars like DADBS_BOOT_SED, DADBS_BOOT_PERL
# that are resolved paths (no symlink) to usable stage1 tooling
DADBS_BOOT_TOOLS=sed,perl,sh,bash,mksh,bison

# These have to be full, explicit paths. Default to mksh as the "standard"
# shell for performance reasons.
SHELL_BOOT_POST_EVAL=$DADBS_BOOT_ROOT/bin/mksh
CONFIG_SHELL_BOOT_POST_EVAL=$DADBS_BOOT_ROOT/bin/mksh

SHELL_POST_EVAL=$DADBS_INSTALL_ROOT/bin/mksh
CONFIG_SHELL_POST_EVAL=$DADBS_INSTALL_ROOT/bin/mksh

DADBS_GCC_CC=gcc
DADBS_CC=gcc
DADBS_GCC_CXX=g++
DADBS_CXX=g++
DADBS_GCC_OPT_SWITCH=-Os
DADBS_ARCH_CFLAGS=-Os
DADBS_ARCH_LDFLAGS=-s
