diff -Naur bison-2.7.1/src/uniqstr.h bison-2.7.1-patched/src/uniqstr.h
--- bison-2.7.1/src/uniqstr.h	2013-04-08 11:42:46.000000000 +0000
+++ bison-2.7.1-patched/src/uniqstr.h	2026-06-14 17:17:02.000000000 +0000
@@ -69,6 +69,39 @@
    checking.  Unfortunately, because of the missing format string in the
    macro invocation, the argument number reported by gcc for a bad
    argument type is 1 too large.  */
+#if defined(AMIX) && !defined(POST_GCC_2723)
+
+  /* 
+   * AMIX/GCC 2.7 workaround:
+   * Use a fixed 20-argument format string and pad with empty strings 
+   * to satisfy vsprintf without complex C99 macro logic.
+   */
+#define UNIQSTR_CONCAT(args...) \
+  uniqstr_vsprintf("%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s", \
+                   args, "", "", "", "", "", "", "", "", "", \
+                   "", "", "", "", "", "", "", "", "", "", "")
+
+#elif defined(AMIX) && defined(POST_GCC_2723)
+
+#define UNIQSTR_CONCAT(args...) \
+  uniqstr_vsprintf (UNIQSTR_GEN_FORMAT (args), args)
+
+#define UNIQSTR_GEN_FORMAT(args...) \
+  UNIQSTR_GEN_FORMAT_ (args, \
+                       "%s", "%s", "%s", "%s", "%s", \
+                       "%s", "%s", "%s", "%s", "%s", \
+                       "%s", "%s", "%s", "%s", "%s", \
+                       "%s", "%s", "%s", "%s", "%s")
+
+#define UNIQSTR_GEN_FORMAT_(F1, F2, F3, F4, F5, \
+                            F6, F7, F8, F9, F10, \
+                            F11, F12, F13, F14, F15, \
+                            F16, F17, F18, F19, F20, \
+                            rest...) \
+  F1 F2 F3 F4 F5 F6 F7 F8 F9 F10 \
+  F11 F12 F13 F14 F15 F16 F17 F18 F19 F20
+
+#else
 #define UNIQSTR_CONCAT(...)                                            \
   uniqstr_vsprintf (UNIQSTR_GEN_FORMAT (__VA_ARGS__,                   \
                                         "%s", "%s", "%s", "%s", "%s",  \
@@ -94,5 +127,6 @@
                             F16, F17, F18, F19, F20, ...) \
   F1  F2  F3  F4  F5  F6  F7  F8  F9  F10                 \
   F11 F12 F13 F14 F15 F16 F17 F18 F19 F20
+#endif
 
