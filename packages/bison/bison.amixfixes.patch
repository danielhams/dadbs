 {
@@ -106,6 +106,26 @@
   return result;
 }
 # define snprintf local_snprintf
+#endif
+
+#if defined(AMIX)
+#include <stdio.h>
+#include <stdarg.h>
+static int
+local_snprintf (char *buf, size_t buflen, const char *format, ...)
+{
+  va_list args;
+  int result;
+
+  va_start (args, format);
+  result = vsprintf (buf, format, args);
+  va_end (args);
+  if (buflen > 0 && (result < 0 || result >= buflen)) {
+    buf[buflen - 1] = '\0';
+  }
+  return result;
+}
+# define snprintf local_snprintf
 #endif
 
