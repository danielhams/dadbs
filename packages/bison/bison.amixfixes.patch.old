+#if defined(AMIX)
+uniqstr
+uniqstr_vsprintf (char const *format, ...)
+{
+  va_list args;
+  char res[4096]; /* Fixed buffer: plenty for Bison internal strings */
+
+  va_start (args, format);
+  vsprintf (res, format, args);
+  va_end (args);
+
+  return uniqstr_new (res);
+}
