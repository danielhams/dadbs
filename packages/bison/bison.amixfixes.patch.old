diff -Naur bison-2.7.1/lib/strerror_r.c bison-2.7.1-patched/lib/strerror_r.c
--- bison-2.7.1/lib/strerror_r.c	2013-04-08 09:18:57.000000000 +0000
+++ bison-2.7.1-patched/lib/strerror_r.c	2026-06-14 17:56:40.000000000 +0000
@@ -91,7 +91,7 @@
    It is of lower quality, but sufficient for the simple use here.
    We only have to make sure to NUL terminate the result (_snprintf
    does not NUL terminate, like strncpy).  */
-#if !HAVE_SNPRINTF
+#if !HAVE_SNPRINTF && !defined(AMIX)
 static int
 local_snprintf (char *buf, size_t buflen, const char *format, ...)
 {
@@ -106,6 +106,26 @@
   return result;
 }
 # define snprintf local_snprintf
+#endif
+
+#if defined(AMIX)
+#include <stdio.h>
+#include <stdarg.h>
+static int
+local_snprintf (char *buf, size_t buflen, const char *format, ...)
+{
+  va_list args;
+  int result;
+
+  va_start (args, format);
+  result = vsprintf (buf, format, args);
+  va_end (args);
+  if (buflen > 0 && (result < 0 || result >= buflen)) {
+    buf[buflen - 1] = '\0';
+  }
+  return result;
+}
+# define snprintf local_snprintf
 #endif
 
 /* Copy as much of MSG into BUF as possible, without corrupting errno.
