#!/usr/bin/env sh

BUILDDIR=$1
INSTALLDIR=$2
EXTRAARGS=$3
. ./setupenv.sh
echo $BUILDDIR
echo $INSTALLDIR
echo $EXTRAARGS
# no configure for bzip
# but we must re-write the Makefile to use the correct
# DADBS_LIBDIR
cd $BUILDDIR
# set the libdir correctly
REPLACE_STRING="s|FIX\)\/lib|FIX\)\/$DADBS_LIBDIR|g"
#echo "Replacing with $REPLACE_STRING"
perl -pi -e $REPLACE_STRING Makefile-libbz2_so || exit 1
# Switch to our CFLAGS
REPLACE_STRING="s|\-O2\s\-g|\-Os|g"
perl -pi -e $REPLACE_STRING Makefile-libbz2_so || exit 1
# Avoid "cp -f"
REPLACE_STRING="s|cp\s\-f|cp|g"
perl -pi -e $REPLACE_STRING Makefile-libbz2_so || exit 1

exit 0
