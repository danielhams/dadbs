+  file = (char const *const *) argv + optind;
 
   if (prompt_once && (x.recursive || 3 < n_files))
     {
@@ -370,7 +373,7 @@
       if (!yesno ())
 	exit (EXIT_SUCCESS);
     }
-  enum RM_status status = rm (n_files, file, &x);
