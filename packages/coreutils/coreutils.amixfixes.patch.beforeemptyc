diff -Naur coreutils-6.12/configure coreutils-6.12-patched/configure
--- coreutils-6.12/configure	2008-05-31 21:23:27.000000000 +0000
+++ coreutils-6.12-patched/configure	2026-06-15 23:32:48.000000000 +0000
@@ -70545,8 +70545,11 @@
 MAN=`echo "$optional_bin_progs "|sed 's/ /.1 /g;s/ $//'|tr -d '\\015\\012'`
 
 # Change ginstall.1 to "install.h" in $MAN.
-MAN=`for m in $MAN; do test $m = ginstall.1 && m=install.1; echo $m; done \
-  | tr '\015\012' ' '; echo`
+# BUG ON AMIX
+#MAN=`for m in $MAN; do test $m = ginstall.1 && m=install.1; echo $m; done \
+#  | tr '\015\012' ' '; echo`
+MAN=`for m in $MAN; do test $m = ginstall.1 && m=install.1; echo $m; done`
+MAN=`echo $MAN`
 
 # Remove [.1, since writing a portable rule for it in man/Makefile.am
 # is not practical.  The sed LHS below uses the autoconf quadrigraph
diff -Naur coreutils-6.12/configure.ac coreutils-6.12-patched/configure.ac
--- coreutils-6.12/configure.ac	2008-05-30 12:05:47.000000000 +0000
+++ coreutils-6.12-patched/configure.ac	2026-06-15 18:55:28.000000000 +0000
@@ -312,8 +312,11 @@
 MAN=`echo "$optional_bin_progs "|sed 's/ /.1 /g;s/ $//'|tr -d '\\015\\012'`
 
 # Change ginstall.1 to "install.h" in $MAN.
-MAN=`for m in $MAN; do test $m = ginstall.1 && m=install.1; echo $m; done \
-  | tr '\015\012' ' '; echo`
+# BUG ON AMIX
+#MAN=`for m in $MAN; do test $m = ginstall.1 && m=install.1; echo $m; done \
+#  | tr '\015\012' ' '; echo`
+MAN=`for m in $MAN; do test $m = ginstall.1 && m=install.1; echo $m; done`
+MAN=`echo $MAN`
 
 # Remove [.1, since writing a portable rule for it in man/Makefile.am
 # is not practical.  The sed LHS below uses the autoconf quadrigraph
diff -Naur coreutils-6.12/lib/empty.c coreutils-6.12-patched/lib/empty.c
--- coreutils-6.12/lib/empty.c	1970-01-01 00:00:00.000000000 +0000
+++ coreutils-6.12-patched/lib/empty.c	2026-06-15 22:20:59.000000000 +0000
@@ -0,0 +1,11 @@
+#include <stddef.h>
+
+/* Minimal stubs for SHA-512 and SHA-256 */
+struct sha_ctx { int dummy; };
+
+void sha512_init_ctx (struct sha_ctx *ctx) {}
+void sha512_process_block (const void *b, size_t l, struct sha_ctx *c) {}
+void sha512_process_bytes (const void *b, size_t l, struct sha_ctx *c) {}
+void *sha512_finish_ctx (struct sha_ctx *c, void *r) { return r; }
+void *sha512_read_ctx (const struct sha_ctx *c, void *r) { return r; }
+void *sha512_buffer (const char *b, size_t l, void *r) { return r; }
diff -Naur coreutils-6.12/lib/fsusage.c coreutils-6.12-patched/lib/fsusage.c
--- coreutils-6.12/lib/fsusage.c	2007-10-17 13:47:25.000000000 +0000
+++ coreutils-6.12-patched/lib/fsusage.c	2026-06-15 21:23:55.000000000 +0000
@@ -64,6 +64,11 @@
    not applicable or unknown.  Propagate this information by returning
    a uintmax_t value that is all 1 bits if X is all 1 bits, even if X
    is unsigned and narrower than uintmax_t.  */
+#if defined(AMIX)
+#define PROPAGATE_ALL_ONES(res) (uintmax_t)(res)
+#define PROPAGATE_TOP_BIT(res) (uintmax_t)(res)
+#define EXTRACT_TOP_BIT(res) ((res) & 0x80000000UL)
+#else
 #define PROPAGATE_ALL_ONES(x) \
   ((sizeof (x) < sizeof (uintmax_t) \
     && (~ (x) == (sizeof (x) < sizeof (int) \
@@ -83,6 +88,7 @@
    Use PROPAGATE_TOP_BIT if the original value might be negative;
    otherwise, use PROPAGATE_ALL_ONES.  */
 #define PROPAGATE_TOP_BIT(x) ((x) | ~ (EXTRACT_TOP_BIT (x) - 1))
+#endif
 
 /* Fill in the fields of FSP with information about space usage for
    the file system on which FILE resides.
diff -Naur coreutils-6.12/lib/mbchar.c coreutils-6.12-patched/lib/mbchar.c
