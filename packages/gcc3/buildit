#!/usr/bin/env sh

BUILDDIR=$1
INSTALLDIR=$2
EXTRAARGS=$3
echo $BUILDDIR
echo $INSTALLDIR
echo $EXTRAARGS
. ./setupenv.sh
cd $BUILDDIR || exit -1
# Only C for now
make CC="$CC" CFLAGS="$CFLAGS" BOOT_CFLAGS="$BOOT_CFLAGS" CFLAGS_FOR_TARGET="$CFLAGS_FOR_TARGET" STAGE1_CFLAGS="$STAGE1_CFLAGS" CXXFLAGS="$CXXFLAGS" LIBGCC2_DEBUG_CFLAGS="$LIBGCC2_DEBUG_CFLAGS" CONFIG_SHELL="$CONFIG_SHELL" SHELL="$SHELL" LANGUAGES="c" || exit -1
exit 0
