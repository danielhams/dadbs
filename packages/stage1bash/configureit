#!/usr/gnutc/bin/sh

BUILDDIR=$1
INSTALLDIR=$2
EXTRAARGS=$3
echo $BUILDDIR
echo $INSTALLDIR
echo $EXTRAARGS
. ./setupenv.sh
cd $BUILDDIR || exit -1

# Early exit for patch building
#exit 1

# Setting CONFIG_SHELL seems to cause issues with CPU regressions
#SHELL=/usr/gnutc/bin/mksh
#CONFIG_SHELL=$SHELL
#export SHELL CONFIG_SHELL

SHELL=/usr/gnutc/bin/sh
export SHELL
unset CONFIG_SHELL

./configure --prefix=$INSTALLDIR --without-gnu-malloc --enable-readline --disable-nls || exit -1
exit 0
