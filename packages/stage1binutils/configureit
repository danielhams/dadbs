#!/usr/bin/env sh

BUILDDIR=$1
INSTALLDIR=$2
EXTRAARGS=$3
echo $BUILDDIR
echo $INSTALLDIR
echo $EXTRAARGS
. ./setupenv.sh
cd $BUILDDIR || exit -1

# Early exist for patch generation
#exit 1

./configure --prefix=$INSTALLDIR --host=m68k-cbm-sysv4 --target=m68k-cbm-sysv4 --enable-targets=m68k-cbm-sysv4 --disable-nls --disable-werror --disable-shared --enable-static || exit -1
exit 0
