#!/usr/gnutc/bin/sh

BUILDDIR=$1
INSTALLDIR=$2
EXTRAARGS=$3
. ./setupenv.sh
echo $BUILDDIR
echo $INSTALLDIR
echo $EXTRAARGS
# no configure for bzip
# but we must re-write the Makefile to use the correct
# DIDBS_LIBDIR
cd $BUILDDIR
REPLACE_STRING="s|FIX\)\/lib|FIX\)\/$DIDBS_LIBDIR|g"
#echo "Replacing with $REPLACE_STRING"
/usr/dadbsbootstrap/bin/perl -pi -e $REPLACE_STRING Makefile || exit 1
REPLACE_STRING="s|\-O2\s\-g|\-Os|g"
/usr/dadbsbootstrap/bin/perl -pi -e $REPLACE_STRING Makefile || exit 1

exit 0
