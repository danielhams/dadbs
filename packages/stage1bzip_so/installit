#!/usr/gnutc/bin/sh

BUILDDIR=$1
INSTALLDIR=$2
EXTRAARGS=$3
echo $BUILDDIR
echo $INSTALLDIR
echo $EXTRAARGS
. ./setupenv.sh
cd $BUILDDIR || exit -1
cp libbz2.so.* $INSTALLDIR/$DIDBS_LIBDIR/ || exit -1
cp bzip2-shared $INSTALLDIR/bin/bzip2 || exit -1
# bzip does this stupid thing where it puts the library in the root of the
# prefix - so let's move it
mv $INSTALLDIR/libbz2.so* $INSTALLDIR/lib/ || exit 1
exit 0
