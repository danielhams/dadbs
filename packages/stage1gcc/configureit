#!/usr/bin/env sh

BUILDDIR=$1
INSTALLDIR=$2
EXTRAARGS=$3
echo $BUILDDIR
echo $INSTALLDIR
echo $EXTRAARGS
. ./setupenv.sh
cd $BUILDDIR || exit -1

# Early exit for patch generation
#exit 1

CC="$CC" CFLAGS="$CFLAGS" CXXFLAGS="$CXXFLAGS" CONFIG_SHELL="$CONFIG_SHELL" SHELL="$SHELL" $SHELL ./configure --prefix=$INSTALLDIR --host=m68k-cbm-sysv4 --target=m68k-cbm-sysv4 --with-gnu-as --with-as=$INSTALLDIR/bin/as --with-gnu-ld --with-ld=$INSTALLDIR/bin/ld --enable-languages=c,c++ --disable-nls --enable-shared || exit -1
exit 0
