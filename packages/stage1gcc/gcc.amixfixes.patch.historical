diff -Naur gcc-2.95.3/gcc/configure gcc-2.95.3-patched/gcc/configure
--- gcc-2.95.3/gcc/configure	2001-03-16 14:13:48.000000000 +0000
+++ gcc-2.95.3-patched/gcc/configure	2026-07-01 09:57:13.000000000 +0100
@@ -5996,23 +5996,35 @@
 		echo "#define TARGET_CPU_DEFAULT ($target_cpu_default)" >>$link
 	fi
 
-	for file in `eval echo '$'$var`; do
-		case $file in
-		auto-config.h)
-			;;
-		*)
-			echo '#ifdef IN_GCC' >>$link
-			;;
-		esac
-		echo "#include \"$file\"" >>$link
-		case $file in
-		auto-config.h)
-			;;
-		*)
-			echo '#endif' >>$link
-			;;
-		esac
-	done
+	# 1. Initialize the file and write the "once-per-file" headers
+        if [ "$link" =  "tm.h" ]; then
+           echo "/* Generated by configure */" >> $link
+            if [ x$gas = xyes ]; then
+               echo "#define USE_GAS" >> $link
+            fi
+            if [ x$gnu_ld = xyes ]; then
+                echo "#define USE_GLD" >> $link
+            fi
+        fi
+
+        # 2. Open the IN_GCC guard (only once)
+        echo '#ifdef IN_GCC' >> $link
+
+        # 3. Iterate through the files and just do the includes
+        for file in `eval echo '$'$var`; do
+            case $file in
+                auto-config.h)
+                  # auto-config.h usually shouldn't be inside the IN_GCC guard 
+                  # in some versions, but for 2.95.3, we can just skip it here
+                    ;;
+                *)
+                    echo "#include \"$file\"" >> $link
+                    ;;
+            esac
+        done
+
+        # 4. Close the IN_GCC guard (only once)
+        echo '#endif' >> $link
 
 	for def in `eval echo '$'$define`; do
 		echo "#ifndef $def" >>$link
diff -Naur gcc-2.95.3/gcc/crtstuff.c gcc-2.95.3-patched/gcc/crtstuff.c
--- gcc-2.95.3/gcc/crtstuff.c	1999-03-23 00:43:51.000000000 +0000
+++ gcc-2.95.3-patched/gcc/crtstuff.c	2026-07-01 12:09:43.000000000 +0100
@@ -185,7 +185,11 @@
 fini_dummy (void)
 {
   asm (FINI_SECTION_ASM_OP);
+#if defined(AMIX)
+  asm ("jbsr __do_global_dtors_aux");
+#else
   __do_global_dtors_aux ();
+#endif
 #ifdef FORCE_FINI_SECTION_ALIGN
   FORCE_FINI_SECTION_ALIGN;
