+			%{pg:gcrti.o%s}%{!pg:crti.o%s} \
+ 			crtbegin.o%s"
 
 /* Attach a special .ident directive to the end of the file to identify
    the version of GCC which compiled this code.  The format of the
diff -Naur gcc-2.95.3/gcc/config/t-svr4 gcc-2.95.3-patched/gcc/config/t-svr4
--- gcc-2.95.3/gcc/config/t-svr4	1998-12-16 21:00:14.000000000 +0000
+++ gcc-2.95.3-patched/gcc/config/t-svr4	2026-07-01 15:07:10.000000000 +0100
@@ -4,5 +4,8 @@
 # we will be doing that, we just always use -fPIC when compiling the
 # routines in crtstuff.c.  Likewise for libgcc2.c.
 
-CRTSTUFF_T_CFLAGS = -fPIC
-TARGET_LIBGCC2_CFLAGS = -fPIC
+# CRTSTUFF_T_CFLAGS = -fPIC
