-  while (REAL_VALUES_LESS (r1, r))
+  while (REAL_VALUES_LESS (r1, r) && i < 16384)
     {
       r1 = REAL_VALUE_LDEXP (dconst1, i);
       if (REAL_VALUES_EQUAL (r1, r))
diff -Naur gcc-2.95.3/gcc/config/m68k/m68k.md gcc-2.95.3-patched/gcc/config/m68k/m68k.md
--- gcc-2.95.3/gcc/config/m68k/m68k.md	1999-08-05 07:22:05.000000000 +0100
