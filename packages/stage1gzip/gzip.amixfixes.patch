diff -Naur gzip-1.9/lib/getprogname.c gzip-1.9-patched/lib/getprogname.c
--- gzip-1.9/lib/getprogname.c	2018-01-07 00:03:28.000000000 +0000
+++ gzip-1.9-patched/lib/getprogname.c	2026-06-13 23:27:30.000000000 +0000
@@ -51,6 +51,27 @@
 # include <sys/procfs.h>
 #endif
 
+#if defined(__AMIX__) || defined(SVR4)
+/* Minimal implementation for SVR4 systems */
+# include <string.h>
+# include <stdlib.h>
+
+char const *
+getprogname (void)
+{
+  /* Fallback: most modern programs set this, 
+     if not, we'll try a static fallback */
+  static char *p = NULL;
+  if (!p) {
+    /* In a real scenario, you'd set this in main(), 
+         but for gzip, we can guess it's gzip */
+      p = "gzip";
+  }
+  return p;
+}
+# define HAVE_GETPROGNAME
+#endif
+
 #include "dirname.h"
 
