#!/usr/gnutc/bin/sh

BUILDDIR=$1
INSTALLDIR=$2
EXTRAARGS=$3
echo $BUILDDIR
echo $INSTALLDIR
echo $EXTRAARGS
. ./setupenv.sh
cd $BUILDDIR || exit -1

# Early exit to enable patch generation
#exit 1

cd ..
mkdir build-libiconv
cd build-libiconv

# Don't use mksh - broken configure/libtool with it
export SHELL=/usr/gnutc/bin/sh
export CONFIG_SHELL=$SHELL

CONFIG_SHELL=$CONFIG_SHELL SHELL=$SHELL $SHELL $BUILDDIR/configure --prefix=$INSTALLDIR --disable-static --enable-dynamic --disable-nls || exit -1
exit 0
