diff -Naur m4-1.4.18/lib/error.h m4-1.4.18-patched/lib/error.h
--- m4-1.4.18/lib/error.h	2016-12-31 13:54:41.000000000 +0000
+++ m4-1.4.18-patched/lib/error.h	2026-06-14 03:50:38.000000000 +0000
@@ -33,6 +33,9 @@
 
 /* On mingw, the flavor of printf depends on whether the extensions module
  * is in use; the check for <stdio.h> determines the witness macro.  */
+#if defined(AMIX)
+#  define _GL_ATTRIBUTE_SPEC_PRINTF __printf__
+#else
 #ifndef _GL_ATTRIBUTE_SPEC_PRINTF
 # if GNULIB_PRINTF_ATTRIBUTE_FLAVOR_GNU
 #  define _GL_ATTRIBUTE_SPEC_PRINTF __gnu_printf__
@@ -40,6 +43,7 @@
 #  define _GL_ATTRIBUTE_SPEC_PRINTF __printf__
 # endif
 #endif
+#endif
 
 #ifdef __cplusplus
 extern "C" {
diff -Naur m4-1.4.18/lib/getprogname.c m4-1.4.18-patched/lib/getprogname.c
--- m4-1.4.18/lib/getprogname.c	2016-12-31 13:54:41.000000000 +0000
+++ m4-1.4.18-patched/lib/getprogname.c	2026-06-14 03:53:42.000000000 +0000
@@ -43,6 +43,28 @@
 # include <string.h>
 #endif
 
+#if defined(__AMIX__) || defined(SVR4)
+/* Minimal implementation for SVR4 systems */
+# include <string.h>
+# include <stdlib.h>
+
+char const *
+getprogname (void)
+{
+  /* Fallback: most modern programs set this,
+     if not, we'll try a static fallback */
+  static char *p = NULL;
+  if (!p) {
+    /* In a real scenario, you'd set this in main(),
+         but for m4, we can guess it's m4 */
+      p = "m4";
+  }
+  return p;
+}
+# define HAVE_GETPROGNAME
+#endif
+
+
 #include "dirname.h"
 
 #ifndef HAVE_GETPROGNAME             /* not Mac OS X, FreeBSD, NetBSD, OpenBSD >= 5.4, Cygwin */
