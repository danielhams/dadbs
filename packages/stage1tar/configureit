#!/usr/bin/env sh

BUILDDIR=$1
INSTALLDIR=$2
EXTRAARGS=$3
echo $BUILDDIR
echo $INSTALLDIR
echo $EXTRAARGS
. ./setupenv.sh
cd $BUILDDIR || exit -1

# Early exit for patch generation
#exit 1

export ACCEPT_INFERIOR_RM_PROGRAM=yes

$SHELL ./configure --prefix=$INSTALLDIR --disable-nls || exit -1
exit 0
